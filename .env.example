# ─────────────────────────────────────────────────────────────
# FHIR Patient Manager — configuration template
# Copy this file to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# FHIR R4 server Base URL (required). All FHIR REST calls are proxied here.
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir/r4

# Optional Bearer token. The proxy sends "Authorization: Bearer <token>"
# on every upstream FHIR request. Leave EMPTY for public servers.
FHIR_BEARER_TOKEN=

# Local port for the web UI + proxy (optional, default 3000)
PORT=3000
